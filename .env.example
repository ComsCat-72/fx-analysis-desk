# Copy to .env and fill in. Never commit .env.
APP_ENV=development                 # development | production (production refuses fixture data)
DATABASE_URL=sqlite:///./var/fxdesk.db
# DATABASE_URL=postgresql+psycopg://fxdesk:password@localhost:5432/fxdesk

# Prices (all free). Twelve Data: free personal key at https://twelvedata.com/pricing (FX pairs and XAU/USD).
# Yahoo Finance needs no key (DXY, Nasdaq-100). PRICE_PROVIDER=yahoo uses Yahoo for every pair (no gold);
# PRICE_PROVIDER=fixture is synthetic development data.
TWELVEDATA_API_KEY=
# PRICE_PROVIDER=yahoo
# Optional: OANDA practice account, where available
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice          # practice | live
# PRICE_PROVIDER=fixture
# CALENDAR_PROVIDER=fixture

# Report writer and semantic review
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_REVIEW_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Bond yields
FRED_API_KEY=

# Hosted deployments: protect writes (and optionally reads) with a shared token
ADMIN_TOKEN=
PROTECT_READS=false
