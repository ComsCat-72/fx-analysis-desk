# Set these in Vercel: Project -> Settings -> Environment Variables. Never commit real values.
ANTHROPIC_API_KEY=        # Claude API key (console.anthropic.com) - writes the reports
ADMIN_TOKEN=              # your password for the Generate page
CRON_SECRET=              # any long random string; Vercel sends it with the daily cron call
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store to the project.
