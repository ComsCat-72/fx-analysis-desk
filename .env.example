# Set these in Vercel: Project -> Settings -> Environment Variables. Never commit real values.
ADMIN_TOKEN=              # your password for changes made from the dashboard
CRON_SECRET=              # any long random string; Vercel sends it with the cron calls
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store to the project.
# Optional, paid: only if you choose the Claude writer in Configure -> Report writer.
# ANTHROPIC_API_KEY=
